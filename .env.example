# ─── Crypto Market Scanner — Environment Variables ───────────────────────────
# Copy this file to .env.local and fill in your values.
# Lines prefixed NEXT_PUBLIC_ are exposed to the browser.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=3000

# ─── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Anthropic Claude API (recommended) ───────────────────────────────────────
# Without this, AI validation falls back to a local heuristic scorer.
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Telegram Bot (optional) ──────────────────────────────────────────────────
# Signals above SCANNER_MIN_CONFIDENCE_ALERT are sent here.
# Create a bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# ─── Market Data Providers (optional) ────────────────────────────────────────
# The scanner uses a failover chain: CoinGecko → Binance → DexScreener → etc.
# All free providers work without keys. Add keys to unlock paid providers.
#
# CoinGecko: free tier works without a key (30 req/min). Pro key removes rate limits.
COINGECKO_API_KEY=
#
# CoinMarketCap: requires a paid or free API key from coinmarketcap.com/api.
# Without a key this provider is disabled; the chain falls through to free providers.
COINMARKETCAP_API_KEY=

# ─── Scanner Defaults ─────────────────────────────────────────────────────────
SCANNER_MIN_CONFIDENCE_ALERT=85   # min confidence to send Telegram alert (50-100)
SCANNER_DELAY_MS=300              # delay between coin scans in ms

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info                    # fatal | error | warn | info | debug | trace

# ─── Rate Limiting (middleware, per IP) ───────────────────────────────────────
RATE_LIMIT_MAX=100                # max requests per window per IP
RATE_LIMIT_WINDOW_MS=60000        # window duration in milliseconds

# ─── CORS (optional) ──────────────────────────────────────────────────────────
# Comma-separated allowed origins. Empty = allow all (safe for local dev).
# Production example: ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
ALLOWED_ORIGINS=

# ─── Admin Authentication (REQUIRED in production) ────────────────────────────
# Comma-separated email addresses allowed to access /admin/* and /api/admin/*.
# If unset, ALL admin routes are blocked — you must set your email here.
# Example: ADMIN_EMAILS=founder@example.com
ADMIN_EMAILS=

# Shared secret between the Next.js proxy and the Python FastAPI backend.
# The proxy adds this as X-Admin-Secret; Python validates it on every request.
# Generate: openssl rand -hex 32
# If unset in dev, the backend accepts all requests from the proxy (no protection).
ADMIN_SECRET=

# Python FastAPI backend URL (Next.js proxy → Python)
# Default: http://localhost:8000
BACKEND_URL=http://localhost:8000
