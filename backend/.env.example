# Copy to .env.local and fill in values.
# The Python backend reads from .env.local (same file as Next.js).

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development        # development | production | test
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
FASTAPI_PORT=8000

# ── Supabase / Postgres ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Direct Postgres URL (bypasses Supabase REST — set for asyncpg pool)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery broker (optional — defaults to REDIS_URL if not set) ───────────────
# Production: use CloudAMQP (RabbitMQ) to eliminate ~34,560 Redis BLPOP ops/day.
# Free tier: cloudamqp.com → Little Lemur plan (1M msgs/month, 3 connections).
# Format: amqps://user:password@hostname/vhost
CELERY_BROKER_URL=

# ── Celery result backend (optional — defaults to REDIS_URL if not set) ────────
# Set to rpc:// to store task results in CloudAMQP instead of Redis.
# Eliminates ~100-300 Redis ops/day from result storage (safe: no code calls .get()).
CELERY_RESULT_BACKEND=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Binance ───────────────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# ── CoinGecko ─────────────────────────────────────────────────────────────────
COINGECKO_API_KEY=

# ── CoinMarketCap ─────────────────────────────────────────────────────────────
COINMARKETCAP_API_KEY=

# ── WhatsApp Alerts via UltraMsg (REQUIRED for signal delivery) ───────────────
# Sign up at ultramsg.com → create an instance → scan QR code with your phone.
# WHATSAPP_API_URL: your instance URL, e.g. https://api.ultramsg.com/instance12345/
# WHATSAPP_TOKEN:   instance token from the UltraMsg dashboard
# WHATSAPP_PHONE:   recipient WhatsApp number with country code, e.g. +919876543210
WHATSAPP_API_URL=https://api.ultramsg.com/instanceXXXXX/
WHATSAPP_TOKEN=your-ultramsg-instance-token
WHATSAPP_PHONE=+919876543210

# ── Scanner ───────────────────────────────────────────────────────────────────
SCANNER_DELAY_MS=300
SCANNER_MIN_CONFIDENCE_ALERT=85
